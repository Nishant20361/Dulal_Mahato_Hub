# ==============================================================================
# Dulal Mahato Hub - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env (and inside backend/.env and frontend/.env) for local setup.

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL via Prisma) - Required in Phase 2+
# Use Session Pooler on port 5432 for runtime (DATABASE_URL) and migrations (DIRECT_URL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Authentication Secrets - Required in Phase 3+
JWT_SECRET="your-super-secret-jwt-access-token-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-token-key-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Brevo Transactional Email API - Required in Phase 4+
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Dulal Mahato Hub"

# Cloudflare R2 Object Storage - Required in Phase 6+
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="dulal-mahato-hub-files"
R2_ENDPOINT="https://[YOUR_ACCOUNT_ID].r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:5001/api/v1"
VITE_APP_NAME="Dulal Mahato Hub"
